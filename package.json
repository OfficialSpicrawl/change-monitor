{
  "name": "spicrawl-change-monitor",
  "version": "0.1.0",
  "description": "Watch URLs and get alerted when their content changes, using the Spicrawl API",
  "private": true,
  "type": "module",
  "bin": {
    "spicrawl-change-monitor": "monitor.mjs"
  },
  "scripts": {
    "start": "node monitor.mjs",
    "test": "node --test monitor.test.mjs demo/test/worker.test.mjs",
    "demo:dev": "wrangler dev --config demo/wrangler.jsonc",
    "demo:deploy": "node scripts/demo-config.mjs && wrangler deploy --config demo/wrangler.local.jsonc"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@spicrawl/sdk": "^0.1.3"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "wrangler": "4.152.0"
  }
}
